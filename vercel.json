{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://render.albiononline.com https://cdn.discordapp.com; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "functions": {
    "api/warband.mjs": {
      "includeFiles": "public/**",
      "maxDuration": 45
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/warband?warbandRoute=home" },
    { "source": "/auth/discord", "destination": "/api/warband?warbandRoute=login" },
    { "source": "/auth/discord/callback", "destination": "/api/warband?warbandRoute=callback" },
    { "source": "/api/:path(board|logout|options|roster|profile|settings|character|expertise|party|templates)", "destination": "/api/warband?warbandRoute=:path" },
    { "source": "/api/party/action", "destination": "/api/warband?warbandRoute=action" },
    { "source": "/api/discord/interactions", "destination": "/api/warband?warbandRoute=interactions" }
  ]
}
